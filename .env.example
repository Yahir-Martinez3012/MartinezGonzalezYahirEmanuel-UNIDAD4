# Copia a .env para Docker local; nunca uses estos valores de ejemplo en producción.
SECRET_KEY=local-only-replace-before-deploy
DEBUG=False
POSTGRES_DB=conecta_utc
POSTGRES_USER=conecta
POSTGRES_PASSWORD=replace-with-a-long-random-value
# Opcional: por defecto Compose construye DATABASE_URL hacia el servicio db local.
# DATABASE_URL=postgresql://conecta:replace-with-a-long-random-value@db:5432/conecta_utc
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
HTTP_PORT=8080
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
APP_VERSION=desarrollo
DEMO_PASSWORD=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
CORREO_REMITENTE=Conecta UTC <onboarding@resend.dev>
